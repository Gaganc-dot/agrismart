{
  "name": "agri-smart-backend",
  "version": "1.0.0",
  "description": "Agri-Smart Connect Backend API",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --ignore data/ server.js",
    "start": "node server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "dotenv/config"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "groq-sdk": "^1.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^8.0.6",
    "razorpay": "^2.9.6",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
